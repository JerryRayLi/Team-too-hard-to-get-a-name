--- !u!114 &362594477
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 362594476}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c93c67fb600cec54084b8c85bd7d2db7, type: 3}
  m_Name:
  m_EditorClassIdentifier: Assembly-CSharp::JerryLevelHelp
  stalledSeconds: 45
  deathsBeforeHelp: 8
  player: {fileID: 1346448136}
  puzzleButtons:
  - {fileID: 1324730383}
  - {fileID: 65106064}
  checkpoint: {fileID: 2100300002}
  progressLandings:
  - {fileID: 1796235307}
  steps:
  - title: Build a route with corpses
    instructions: Use the two lower spikes to leave corpses as stepping stones. Start
      with the spike nearest your starting deck, then use its corpse to reach the
      next spike.
    targets:
    - target: {fileID: 907104357}
      localOffset: {x: 0, y: 0.14434624, z: 0}
      caption: First corpse
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
    - target: {fileID: 1136228738}
      localOffset: {x: 0, y: 0.144346, z: 0}
      caption: Next corpse
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
  - title: Climb before releasing
    instructions: Use the corpses to reach the left side of the middle deck BEFORE
      pressing E. E drops ALL corpses in your circle, including any corpse you are
      standing on.
    targets:
    - target: {fileID: 1136228738}
      localOffset: {x: 0, y: 0.144346, z: 0}
      caption: Keep this corpse as a step
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
    - target: {fileID: 216073495}
      localOffset: {x: -0.36764705, y: 1.1666667, z: 0}
      caption: Reach this deck
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
  - title: Use the red fragile button
    instructions: Land on the middle deck first. Bright corners mark ALL corpses
      E will release. Keep the higher corpse marked, press E, then use RED to open
      Gate A.
    targets:
    - target: {fileID: 1324730382}
      localOffset: {x: 0, y: -0.35000086, z: 0}
      caption: 'Drop corpse: RED'
      color: {r: 0.86, g: 0.35826322, b: 0.3063594, a: 1}
    - target: {fileID: 1531337465}
      localOffset: {x: 0, y: 0, z: 0}
      caption: Gate A
      color: {r: 0.86, g: 0.35826322, b: 0.3063594, a: 1}
  - title: Save the checkpoint quickly
    instructions: Cross Gate A and touch the CHECKPOINT until it says SAVED. Button
      A breaks 3 seconds after contact. If you miss the checkpoint, press R to retry.
    targets:
    - target: {fileID: 1498328582}
      localOffset: {x: -0.000000059604645, y: 0, z: 0}
      caption: Touch to save
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
  - title: Prepare the upper corpse
    instructions: From the checkpoint, use the small upper step to jump into the
      upper spike. After respawning at the checkpoint, climb onto this new corpse.
    targets:
    - target: {fileID: 1488741569}
      localOffset: {x: 0, y: 1.5789471, z: 0}
      caption: Small upper step
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
    - target: {fileID: 1453500112}
      localOffset: {x: 0.00000023841858, y: 0.14434576, z: 0}
      caption: Leave an upper corpse
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
  - title: Reach the upper deck, then release
    instructions: Land on the LEFT EDGE of the upper deck. Keep the upper corpse
      marked, then press E to drop ALL marked corpses onto the BLUE button. Switch
      to BLUE.
    targets:
    - target: {fileID: 1796235307}
      localOffset: {x: -0.48026317, y: 1.2666674, z: 0}
      caption: Land on the left edge
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
    - target: {fileID: 65106063}
      localOffset: {x: 0, y: -0.34999967, z: 0}
      caption: 'Drop corpse: BLUE'
      color: {r: 0.32895, g: 0.74078476, b: 0.86, a: 1}
  - title: Take the exit before B breaks
    instructions: Keep BLUE and run through Gate B to the exit. Button B breaks 3
      seconds after contact. If it breaks before you can finish, press R; your saved
      checkpoint is kept.
    targets:
    - target: {fileID: 246665702}
      localOffset: {x: 0, y: 0, z: 0}
      caption: Gate B
      color: {r: 0.32895, g: 0.74078476, b: 0.86, a: 1}
    - target: {fileID: 1731675083}
      localOffset: {x: 0, y: 0, z: 0}
      caption: Exit
      color: {r: 1, g: 0.83, b: 0.4, a: 1}
